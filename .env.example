# Portfolio Dashboard — Environment Variables
# Copy this file to .env.local and fill in the values

# Poll interval for live price refresh (milliseconds)
# Default: 15000 (15 seconds)
NEXT_PUBLIC_POLL_INTERVAL_MS=15000

# Optional: Alpha Vantage API key for fundamentals data
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Optional: Financial Modeling Prep API key
# Get a free key at https://financialmodelingprep.com/developer
FMP_API_KEY=twSDrMlmIBktInNstZ1bmnT3qVWDpeiR
